# Dipakai otomatis oleh `vite build` (mode production).
# Frontend & backend disajikan dari domain yang sama lewat proxy nginx
# (lih. /etc/nginx/sites-enabled/cmms -> location /api/), jadi path relatif
# sudah cukup dan otomatis benar untuk domain apa pun yang dipakai mengakses site.
VITE_API_BASE_URL=https://computerize-maintenance-management-system-production.up.railway.app/api
